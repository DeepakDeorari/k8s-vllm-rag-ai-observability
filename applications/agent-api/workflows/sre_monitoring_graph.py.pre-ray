def collect_restart_metrics_node(
    state: SreGraphState,
) -> dict:
    """
    Collect historical Kubernetes pod restart data.
    """

    try:
        return {
            "restart_metrics": (
                get_restarting_pods()
            )
        }

    except Exception as exc:
        return {
            "error": (
                "Kubernetes restart diagnostics failed: "
                f"{type(exc).__name__}: {exc}"
            )
        }

def build_restart_retrieval_query_node(
    state: SreGraphState,
) -> dict:
    """
    Build a Qdrant retrieval query using both the user's question
    and the structured Kubernetes restart evidence.

    Only a compact summary of the top restart observations is used.
    The complete Kubernetes evidence remains separately preserved
    in graph state.
    """

    if state.get("error"):
        return {
            "retrieval_query": "",
        }

    question = state.get(
        "question",
        "",
    ).strip()

    restart_metrics = state.get(
        "restart_metrics",
        {},
    )

    total_pods = restart_metrics.get(
        "total_pod_count",
        0,
    )

    restarting_count = restart_metrics.get(
        "restarting_pod_count",
        0,
    )

    restarting_pods = restart_metrics.get(
        "restarting_pods",
        [],
    )

    query_parts = [
        "Kubernetes pod restart investigation.",
        f"User question: {question}",
        f"Total pods inspected: {total_pods}.",
        (
            "Pods with historical container restarts: "
            f"{restarting_count}."
        ),
    ]

    if restarting_pods:
        query_parts.append(
            "Highest restart workloads:"
        )

        for pod in restarting_pods[:3]:
            query_parts.append(
                (
                    f"{pod.get('namespace')}/"
                    f"{pod.get('pod')} "
                    f"has {pod.get('total_restarts')} "
                    "accumulated restarts, "
                    f"phase {pod.get('phase')}, "
                    f"scheduled on {pod.get('node')}."
                )
            )
    else:
        query_parts.append(
            "No pods have recorded container restarts."
        )

    retrieval_query = " ".join(
        query_parts
    )

    return {
        "retrieval_query": retrieval_query,
    }

def retrieve_restart_knowledge_node(
    state: SreGraphState,
) -> dict:
    """
    Retrieve unique platform knowledge related to the observed
    Kubernetes restart evidence.
    """

    if state.get("error"):
        return {
            "retrieved_documents": [],
            "retrieval_count": 0,
        }

    retrieval_query = state.get(
        "retrieval_query",
        "",
    ).strip()

    if not retrieval_query:
        return {
            "retrieved_documents": [],
            "retrieval_count": 0,
            "error": (
                "Knowledge retrieval could not run because "
                "the retrieval query was empty."
            ),
        }

    try:
        result = retrieve_documents(
            question=retrieval_query,
            limit=3,
        )

        return {
            "retrieved_documents": result.get(
                "documents",
                [],
            ),
            "retrieval_count": result.get(
                "result_count",
                0,
            ),
        }

    except Exception as exc:
        return {
            "retrieved_documents": [],
            "retrieval_count": 0,
            "error": (
                "Qdrant knowledge retrieval failed: "
                f"{type(exc).__name__}: {exc}"
            ),
        }

def analyze_restart_evidence_node(
    state: SreGraphState,
) -> dict:
    """
    Use Qwen through vLLM to analyze Kubernetes restart evidence
    together with relevant Qdrant knowledge.

    Exact Kubernetes values remain stored separately in graph state.
    This node provides interpretation only.

    The model must not invent causes, alter values, or claim that
    historical restarts prove a current incident.
    """

    if state.get("error"):
        return {
            "analysis": "",
            "analysis_error": (
                "Analysis was skipped because an earlier "
                "workflow step failed."
            ),
        }

    question = state.get(
        "question",
        "",
    ).strip()

    restart_metrics = state.get(
        "restart_metrics",
        {},
    )

    total_pods = restart_metrics.get(
        "total_pod_count",
        0,
    )

    restarting_count = restart_metrics.get(
        "restarting_pod_count",
        0,
    )

    restarting_pods = restart_metrics.get(
        "restarting_pods",
        [],
    )

    retrieved_documents = state.get(
        "retrieved_documents",
        [],
    )

    evidence_lines = [
        f"Total pods inspected: {total_pods}",
        (
            "Pods with one or more historical "
            f"container restarts: {restarting_count}"
        ),
    ]

    if restarting_pods:
        evidence_lines.append(
            "Highest restart workloads:"
        )

        for pod in restarting_pods[:5]:
            evidence_lines.append(
                (
                    f"- {pod.get('namespace')}/"
                    f"{pod.get('pod')} | "
                    f"restart_count="
                    f"{pod.get('total_restarts')} | "
                    f"phase={pod.get('phase')} | "
                    f"node={pod.get('node')}"
                )
            )
    else:
        evidence_lines.append(
            "No pods have recorded container restarts."
        )

    knowledge_lines = []

    for index, document in enumerate(
        retrieved_documents,
        start=1,
    ):
        knowledge_lines.append(
            (
                f"{index}. "
                f"Similarity={document.get('score')} | "
                f"{document.get('text')}"
            )
        )

    if not knowledge_lines:
        knowledge_lines.append(
            "No relevant runbook documents were retrieved."
        )

    evidence_text = "\n".join(
        evidence_lines
    )

    knowledge_text = "\n".join(
        knowledge_lines
    )

    messages = [
        (
            "system",
(
    "You are a read-only Kubernetes SRE analysis "
    "assistant.\n\n"

    "Your analysis must be grounded strictly in the supplied "
    "live Kubernetes evidence and retrieved platform knowledge.\n\n"

    "CRITICAL RULES:\n"
    "1. Never invent or assume a root cause.\n"
    "2. Never list hypothetical causes unless a supplied "
    "document explicitly supports them and the live evidence "
    "is consistent with them.\n"
    "3. Do not infer CPU pressure, memory pressure, network "
    "problems, application bugs, configuration problems, "
    "probe failures, or resource exhaustion unless the live "
    "evidence explicitly demonstrates that condition.\n"
    "4. Historical restart counts alone do not prove that a "
    "workload is currently unhealthy.\n"
    "5. Preserve exact pod names, namespaces, node names, "
    "phases, and restart counts from the supplied evidence.\n"
    "6. Clearly distinguish facts from recommended checks.\n"
    "7. Recommendations must be read-only verification steps.\n"
    "8. Never recommend deleting, restarting, scaling, "
    "patching, or modifying a workload.\n"
    "9. If the root cause cannot be determined from the "
    "supplied evidence, explicitly say: "
    "'Root cause cannot be determined from the current evidence.'\n"
    "10. Be concise. Do not produce long explanations.\n\n"

    "Return exactly these four sections:\n\n"

    "Assessment:\n"
    "- Maximum 3 bullet points containing observed facts only.\n\n"

    "Evidence interpretation:\n"
    "- Maximum 3 bullet points.\n"
    "- Explain only what the evidence supports.\n\n"

    "Recommended verification:\n"
    "- Maximum 5 read-only checks derived from the retrieved "
    "runbook.\n\n"

    "Conclusion:\n"
    "- Maximum 2 sentences.\n"
    "- State whether an active incident or root cause can "
    "actually be established."
),
        ),
        (
            "human",
            (
                f"User question:\n{question}\n\n"

                "Live Kubernetes evidence:\n"
                f"{evidence_text}\n\n"

                "Retrieved platform knowledge:\n"
                f"{knowledge_text}"
            ),
        ),
    ]

    try:
        response = analysis_llm.invoke(
            messages
        )

        analysis = str(
            response.content
        ).strip()

        if not analysis:
            return {
                "analysis": "",
                "analysis_error": (
                    "Qwen returned an empty analysis."
                ),
            }

        return {
            "analysis": analysis,
            "analysis_error": "",
        }

    except Exception as exc:
        return {
            "analysis": "",
            "analysis_error": (
                "Grounded analysis failed: "
                f"{type(exc).__name__}: {exc}"
            ),
        }

def build_safe_restart_analysis(
    state: SreGraphState,
) -> str:
    """
    Build a deterministic fallback analysis from structured
    Kubernetes evidence.

    This function does not use an LLM and does not infer a root
    cause.
    """

    restart_metrics = state.get(
        "restart_metrics",
        {},
    )

    total_pods = restart_metrics.get(
        "total_pod_count",
        0,
    )

    restarting_count = restart_metrics.get(
        "restarting_pod_count",
        0,
    )

    restarting_pods = restart_metrics.get(
        "restarting_pods",
        [],
    )

    lines = [
        "Assessment:",
        (
            f"- {restarting_count} of {total_pods} inspected "
            "pods have recorded historical container restarts."
        ),
    ]

    if restarting_pods:
        highest_restart_pod = restarting_pods[0]

        lines.append(
            "- The highest observed restart count is "
            f"{highest_restart_pod.get('total_restarts')} for "
            f"{highest_restart_pod.get('namespace')}/"
            f"{highest_restart_pod.get('pod')}."
        )

        running_count = sum(
            1
            for pod in restarting_pods[:10]
            if pod.get("phase") == "Running"
        )

        displayed_count = min(
            len(restarting_pods),
            10,
        )

        lines.append(
            f"- {running_count} of the {displayed_count} "
            "displayed high-restart pods are currently in "
            "the Running phase."
        )
    else:
        lines.append(
            "- No pods with historical container restarts "
            "were found."
        )

    lines.extend(
        [
            "",
            "Evidence interpretation:",
            (
                "- Historical restart counts confirm that "
                "container restarts occurred previously."
            ),
            (
                "- Historical restart counts alone do not "
                "prove that a workload is currently unhealthy."
            ),
            (
                "- The available evidence includes pod phase "
                "but does not include current container "
                "readiness, waiting reasons, last termination "
                "details, recent events, or restart-count "
                "growth over time."
            ),
            "",
            "Recommended verification:",
            "- Check current container readiness.",
            "- Check current container waiting reasons.",
            (
                "- Inspect the last terminated reason and "
                "exit code."
            ),
            "- Review recent Kubernetes warning events.",
            (
                "- Determine whether restart counts are "
                "continuing to increase."
            ),
            "",
            "Conclusion:",
            (
                "- An active workload failure is not "
                "established by the available evidence."
            ),
            (
                "- Root cause cannot be determined from "
                "the current evidence."
            ),
        ]
    )

    return "\n".join(lines)

def validate_restart_analysis_node(
    state: SreGraphState,
) -> dict:
    """
    Validate Qwen's candidate restart analysis before allowing it
    into the final operational report.

    The candidate is rejected when it:
    - Omits required sections
    - Omits exact workload identifiers
    - Introduces unsupported causal speculation
    - Omits the root-cause disclaimer
    - Recommends a state-changing action
    - Is empty or excessively long

    When validation fails, a deterministic safe fallback is used.
    """

    analysis = state.get(
        "analysis",
        "",
    ).strip()

    analysis_error = state.get(
        "analysis_error",
        "",
    ).strip()

    restart_metrics = state.get(
        "restart_metrics",
        {},
    )

    restarting_pods = restart_metrics.get(
        "restarting_pods",
        [],
    )

    validation_errors = []

    if analysis_error:
        validation_errors.append(
            f"Analysis generation failed: {analysis_error}"
        )

    if not analysis:
        validation_errors.append(
            "Qwen returned an empty analysis."
        )

    if len(analysis) > 4000:
        validation_errors.append(
            "The analysis exceeded the maximum allowed length."
        )

    normalized_analysis = analysis.casefold()

    required_sections = (
        "assessment:",
        "evidence interpretation:",
        "recommended verification:",
        "conclusion:",
    )

    for section in required_sections:
        if section not in normalized_analysis:
            validation_errors.append(
                f"Required section is missing: {section}"
            )

    required_disclaimer = (
        "root cause cannot be determined from "
        "the current evidence"
    )

    if required_disclaimer not in normalized_analysis:
        validation_errors.append(
            "The required root-cause disclaimer is missing."
        )

    # Require exact operational identifiers for the three
    # highest-restart workloads.
    for pod in restarting_pods[:3]:
        workload_identifier = (
            f"{pod.get('namespace')}/"
            f"{pod.get('pod')}"
        )

        if workload_identifier not in analysis:
            validation_errors.append(
                "Exact workload identifier was not preserved: "
                f"{workload_identifier}"
            )

    if restarting_pods:
        observed_phases = {
            str(pod.get("phase"))
            for pod in restarting_pods[:5]
            if pod.get("phase")
        }

        for phase in observed_phases:
            if phase.casefold() not in normalized_analysis:
                validation_errors.append(
                    "Observed pod phase was not acknowledged: "
                    f"{phase}"
                )

    unsupported_causal_phrases = (
        "resource contention",
        "resource exhaustion",
        "memory pressure",
        "cpu pressure",
        "network instability",
        "application bugs",
        "application bug",
        "performance bottleneck",
        "misconfiguration",
        "underlying infrastructure",
        "infrastructure instability",
        "could indicate",
        "may indicate",
        "likely caused by",
        "caused by",
    )

    for phrase in unsupported_causal_phrases:
        if phrase in normalized_analysis:
            validation_errors.append(
                "Unsupported causal speculation was found: "
                f"{phrase}"
            )

    destructive_action_phrases = (
        "delete the pod",
        "delete the pods",
        "restart the pod",
        "restart the pods",
        "rollout restart",
        "scale the deployment",
        "patch the deployment",
        "modify the deployment",
        "cordon the node",
        "drain the node",
    )

    for phrase in destructive_action_phrases:
        if phrase in normalized_analysis:
            validation_errors.append(
                "State-changing recommendation was found: "
                f"{phrase}"
            )

    analysis_valid = (
        len(validation_errors) == 0
    )

    if analysis_valid:
        validated_analysis = analysis
    else:
        validated_analysis = (
            build_safe_restart_analysis(
                state
            )
        )

    return {
        "analysis_valid": analysis_valid,
        "analysis_validation_errors": (
            validation_errors
        ),
        "validated_analysis": (
            validated_analysis
        ),
    }


def collect_unhealthy_metrics_node(
    state: SreGraphState,
) -> dict:
    """
    Collect information about currently unhealthy pods.
    """

    try:
        return {
            "unhealthy_metrics": (
                get_unhealthy_pods()
            )
        }

    except Exception as exc:
        return {
            "error": (
                "Kubernetes pod-health diagnostics failed: "
                f"{type(exc).__name__}: {exc}"
            )
        }


def format_cpu_response_node(
    state: SreGraphState,
) -> dict:
    """
    Format CPU metrics deterministically.
    """

    if state.get("error"):
        return {
            "final_answer": state["error"],
        }

    nodes = state.get(
        "cpu_metrics",
        {},
    ).get(
        "nodes",
        [],
    )

    if not nodes:
        return {
            "final_answer": (
                "No Kubernetes node CPU metrics were "
                "returned by Prometheus."
            )
        }

    lines = [
        "Current Kubernetes node CPU utilization:"
    ]

    for node in nodes:
        instance = node.get("instance")

        cpu_percent = node.get(
            "cpu_utilization_percent"
        )

        if cpu_percent is None:
            lines.append(
                f"- {instance}: unavailable"
            )
        else:
            lines.append(
                f"- {instance}: {cpu_percent}%"
            )

    return {
        "final_answer": "\n".join(lines),
    }


def format_health_response_node(
    state: SreGraphState,
) -> dict:
    """
    Format Prometheus target-health data deterministically.
    """

    if state.get("error"):
        return {
            "final_answer": state["error"],
        }

    health_metrics = state.get(
        "health_metrics",
    {},
    )

    total_count = health_metrics.get(
        "total_target_count",
        0,
    )

    up_count = health_metrics.get(
        "up_target_count",
        0,
    )

    down_count = health_metrics.get(
        "down_target_count",
        0,
    )

    lines = [
        "Prometheus target health:",
        f"- Total targets: {total_count}",
        f"- UP targets: {up_count}",
        f"- DOWN targets: {down_count}",
    ]

    down_targets = [
        target
        for target in health_metrics.get(
            "targets",
            [],
        )
        if target.get("status") == "DOWN"
    ]

    if down_targets:
        lines.append("- Unhealthy targets:")

        for target in down_targets:
            lines.append(
                "- "
                f"{target.get('job')} | "
                f"{target.get('instance')} | "
                f"namespace="
                f"{target.get('namespace')}"
            )
    else:
        lines.append(
            "- All discovered Prometheus targets "
            "are UP."
        )

    return {
        "final_answer": "\n".join(lines),
    }


def format_restart_response_node(
    state: SreGraphState,
) -> dict:
    """
    Format Kubernetes restart evidence together with relevant
    knowledge retrieved from the existing Phase 2 Qdrant collection.

    Exact Kubernetes values are formatted deterministically.
    Retrieved documents are listed separately and are not treated
    as live operational evidence.
    """

    if state.get("error"):
        return {
            "final_answer": state["error"],
        }

    restart_metrics = state.get(
        "restart_metrics",
        {},
    )

    total_pods = restart_metrics.get(
        "total_pod_count",
        0,
    )

    restarting_pods = restart_metrics.get(
        "restarting_pods",
        [],
    )

    restarting_count = restart_metrics.get(
        "restarting_pod_count",
        0,
    )

    retrieved_documents = state.get(
        "retrieved_documents",
        [],
    )

    validated_analysis = state.get(
        "validated_analysis",
        "",
    ).strip()

    analysis_valid = state.get(
        "analysis_valid",
        False,
    )

    validation_errors = state.get(
        "analysis_validation_errors",
        [],
    )

    lines = [
        "Kubernetes pod restart investigation:",
        "",
        "Observed Kubernetes evidence:",
        f"- Total pods inspected: {total_pods}",
        (
            "- Pods with one or more historical "
            f"restarts: {restarting_count}"
        ),
    ]

    if not restarting_pods:
        lines.append(
            "- No pods have recorded container restarts."
        )
    else:
        lines.append(
            "- Top pods by accumulated restart count:"
        )

        for pod in restarting_pods[:10]:
            lines.append(
                "- "
                f"{pod.get('namespace')}/"
                f"{pod.get('pod')} | "
                f"restarts={pod.get('total_restarts')} | "
                f"phase={pod.get('phase')} | "
                f"node={pod.get('node')}"
            )

        lines.append(
            "- Historical restarts do not necessarily "
            "mean the pods are currently unhealthy."
        )

    lines.extend(
        [
            "",
            "Relevant platform knowledge:",
        ]
    )

    if not retrieved_documents:
        lines.append(
            "- No relevant platform documents were retrieved."
        )
    else:
        for index, document in enumerate(
            retrieved_documents,
            start=1,
        ):
            lines.append(
                f"{index}. "
                f"[similarity={document.get('score')}] "
                f"{document.get('text')}"
            )

    lines.extend(
        [
            "",
            "Grounded Qwen analysis:",
        ]
    )

    if validated_analysis:
        lines.append(
            validated_analysis
        )
    else:
        lines.append(
            "- No validated analysis was available."
        )

    lines.extend(
        [
            "",
            "Analysis validation:",
            (
                "- Status: PASS"
                if analysis_valid
                else "- Status: FALLBACK USED"
            ),
        ]
    )

    if validation_errors:
        lines.append(
            "- Candidate Qwen analysis was rejected for:"
        )

        for validation_error in validation_errors:
            lines.append(
                f"  - {validation_error}"
            )

    return {
        "final_answer": "\n".join(lines),
    }

def format_unhealthy_response_node(
    state: SreGraphState,
) -> dict:
    """
    Format current Kubernetes pod-health diagnostics.
    """

    if state.get("error"):
        return {
            "final_answer": state["error"],
        }

    unhealthy_metrics = state.get(
        "unhealthy_metrics",
        {},
    )

    total_pods = unhealthy_metrics.get(
        "total_pod_count",
        0,
    )

    unhealthy_count = unhealthy_metrics.get(
        "unhealthy_pod_count",
        0,
    )

    unhealthy_pods = unhealthy_metrics.get(
        "unhealthy_pods",
        [],
    )

    lines = [
        "Current Kubernetes pod health:",
        f"- Total pods inspected: {total_pods}",
        (
            "- Currently unhealthy pods: "
            f"{unhealthy_count}"
        ),
    ]

    if not unhealthy_pods:
        lines.append(
            "- No currently unhealthy pods were found."
        )

        return {
            "final_answer": "\n".join(lines),
        }

    lines.append("- Unhealthy pod details:")

    for pod in unhealthy_pods:
        lines.append(
            "- "
            f"{pod.get('namespace')}/"
            f"{pod.get('pod')} | "
            f"phase={pod.get('phase')} | "
            f"node={pod.get('node')}"
        )

        for container in pod.get(
            "containers",
            [],
        ):
            lines.append(
                "  - "
                f"container="
                f"{container.get('container')} | "
                f"ready={container.get('ready')} | "
                f"restarts="
                f"{container.get('restart_count')} | "
                f"waiting_reason="
                f"{container.get('waiting_reason')} | "
                f"terminated_reason="
                f"{container.get('terminated_reason')} | "
                f"exit_code="
                f"{container.get('exit_code')}"
            )

    return {
        "final_answer": "\n".join(lines),
    }


def unsupported_question_node(
    state: SreGraphState,
) -> dict:
    """
    Return a controlled response for unsupported requests.
    """

    if state.get("error"):
        return {
            "final_answer": (
                "The SRE monitoring request could not be "
                "completed safely. Details: "
                f"{state['error']}"
            )
        }

    return {
        "final_answer": (
            "This workflow currently supports Kubernetes "
            "node CPU usage, Prometheus target health, "
            "historical pod restarts, and current unhealthy "
            "pod diagnostics."
        )
    }


def build_sre_monitoring_graph():
    """
    Build and compile the expanded SRE monitoring graph.
    """

    graph = StateGraph(SreGraphState)

    graph.add_node(
        "classify_primary_intent",
        classify_primary_intent_node,
    )

    graph.add_node(
        "classify_kubernetes_intent",
        classify_kubernetes_intent_node,
    )

    graph.add_node(
        "collect_cpu_metrics",
        collect_cpu_metrics_node,
    )

    graph.add_node(
        "collect_health_metrics",
        collect_health_metrics_node,
    )

    graph.add_node(
        "collect_restart_metrics",
        collect_restart_metrics_node,
    )

    graph.add_node(
        "build_restart_retrieval_query",
        build_restart_retrieval_query_node,
    )

    graph.add_node(
        "retrieve_restart_knowledge",
        retrieve_restart_knowledge_node,
    )

    graph.add_node(
        "analyze_restart_evidence",
        analyze_restart_evidence_node,
    )

    graph.add_node(
        "validate_restart_analysis",
        validate_restart_analysis_node,
    )

    graph.add_node(
        "collect_unhealthy_metrics",
        collect_unhealthy_metrics_node,
    )

    graph.add_node(
        "format_cpu_response",
        format_cpu_response_node,
    )

    graph.add_node(
        "format_health_response",
        format_health_response_node,
    )

    graph.add_node(
        "format_restart_response",
        format_restart_response_node,
    )

    graph.add_node(
        "format_unhealthy_response",
        format_unhealthy_response_node,
    )

    graph.add_node(
        "unsupported_question",
        unsupported_question_node,
    )

    graph.add_edge(
        START,
        "classify_primary_intent",
    )

    graph.add_conditional_edges(
        "classify_primary_intent",
        route_primary_intent,
        {
            "collect_cpu_metrics": (
                "collect_cpu_metrics"
            ),
            "collect_health_metrics": (
                "collect_health_metrics"
            ),
            "classify_kubernetes_intent": (
                "classify_kubernetes_intent"
            ),
            "unsupported_question": (
                "unsupported_question"
            ),
        },
    )

    graph.add_conditional_edges(
        "classify_kubernetes_intent",
        route_kubernetes_intent,
        {
            "collect_restart_metrics": (
                "collect_restart_metrics"
            ),
            "collect_unhealthy_metrics": (
                "collect_unhealthy_metrics"
            ),
            "unsupported_question": (
                "unsupported_question"
            ),
        },
    )

    graph.add_edge(
        "collect_cpu_metrics",
        "format_cpu_response",
    )

    graph.add_edge(
        "collect_health_metrics",
        "format_health_response",
    )

    graph.add_edge(
        "collect_restart_metrics",
        "build_restart_retrieval_query",
    )

    graph.add_edge(
        "build_restart_retrieval_query",
        "retrieve_restart_knowledge",
    )

    graph.add_edge(
        "retrieve_restart_knowledge",
        "analyze_restart_evidence",
    )

    graph.add_edge(
        "analyze_restart_evidence",
        "validate_restart_analysis",
    )

    graph.add_edge(
        "validate_restart_analysis",
        "format_restart_response",
    )

    graph.add_edge(
        "collect_unhealthy_metrics",
        "format_unhealthy_response",
    )

    graph.add_edge(
        "format_cpu_response",
        END,
    )

    graph.add_edge(
        "format_health_response",
        END,
    )

    graph.add_edge(
        "format_restart_response",
        END,
    )

    graph.add_edge(
        "format_unhealthy_response",
        END,
    )

    graph.add_edge(
        "unsupported_question",
        END,
    )

    return graph.compile()


sre_monitoring_graph = build_sre_monitoring_graph()
