from typing import Literal
from typing import TypedDict

from langchain_openai import ChatOpenAI
from langgraph.graph import END
from langgraph.graph import START
from langgraph.graph import StateGraph

from config.langgraph_models import (
    QWEN_API_KEY,
    QWEN_BASE_URL,
    QWEN_MODEL,
)
from tools.kubernetes_pods import (
    get_restarting_pods,
    get_unhealthy_pods,
)
from tools.prometheus_cpu import (
    get_current_node_cpu_percent,
)
from tools.prometheus_health import (
    get_prometheus_target_health,
)
from tools.qdrant_retriever import (
    retrieve_documents,
)


class SreGraphState(TypedDict, total=False):
    """
    Shared state for the SRE monitoring workflow.
    """

    question: str

    route: Literal[
        "cpu",
        "health",
        "kubernetes",
        "unsupported",
    ]

    kubernetes_intent: Literal[
        "restarts",
        "unhealthy",
        "unsupported",
    ]

    classification_raw: str
    classification_reason: str

    kubernetes_classification_raw: str
    kubernetes_classification_reason: str

    cpu_metrics: dict
    health_metrics: dict
    restart_metrics: dict
    unhealthy_metrics: dict

    retrieval_query: str
    retrieved_documents: list
    retrieval_count: int
    
    analysis: str
    analysis_error: str

    analysis_valid: bool
    analysis_validation_errors: list
    validated_analysis: str

    final_answer: str
    error: str


classifier_llm = ChatOpenAI(
    model=QWEN_MODEL,
    base_url=QWEN_BASE_URL,
    api_key=QWEN_API_KEY,
    temperature=0,
    max_tokens=30,
    timeout=30,
    max_retries=2,
)

analysis_llm = ChatOpenAI(
    model=QWEN_MODEL,
    base_url=QWEN_BASE_URL,
    api_key=QWEN_API_KEY,
    temperature=0,
    max_tokens=600,
    timeout=60,
    max_retries=2,
)


def normalize_primary_route(
    model_output: str,
    question: str,
) -> Literal[
    "cpu",
    "health",
    "kubernetes",
    "unsupported",
]:
    """
    Normalize Qwen output into a valid primary route.

    The function uses an explicit allowlist of approved model-output
    aliases. It also uses the original question only when an output
    such as UNHEALTHY is ambiguous between Prometheus health and
    Kubernetes workload health.

    Anything unrecognized fails closed to unsupported.
    """

    cleaned_output = (
        model_output
        .strip()
        .upper()
        .replace("-", "_")
        .replace(" ", "_")
    )

    cleaned_question = question.strip().lower()

    cpu_aliases = {
        "CPU",
        "CPU_USAGE",
        "CPU_UTILIZATION",
        "NODE_CPU",
        "NODE_CPU_USAGE",
        "NODE_CPU_UTILIZATION",
        "KUBERNETES_CPU",
        "KUBERNETES_NODE_CPU",
        "KUBERNETES_NODE_CPU_USAGE",
        "KUBERNETES_NODE_CPU_UTILIZATION",
        "PROCESSOR_USAGE",
        "PROCESSOR_UTILIZATION",
        "COMPUTE_USAGE",
        "COMPUTE_UTILIZATION",
        "CLUSTER_CPU_USAGE",
        "CLUSTER_CPU_UTILIZATION",
    }

    health_aliases = {
        "HEALTH",
        "PROMETHEUS_HEALTH",
        "TARGET_HEALTH",
        "PROMETHEUS_TARGET_HEALTH",
        "SCRAPE_HEALTH",
        "PROMETHEUS_SCRAPE_HEALTH",
        "TARGETS",
    }

    kubernetes_aliases = {
        "KUBERNETES",
        "K8S",
        "RESTARTS",
        "POD_RESTARTS",
        "CONTAINER_RESTARTS",
        "HISTORICAL_RESTARTS",
        "HISTORICAL_POD_RESTARTS",
        "HISTORICAL_CONTAINER_RESTARTS",
        "RESTART_COUNT",
        "RESTART_COUNTS",
        "CRASHLOOPBACKOFF",
        "CRASH_LOOP_BACK_OFF",
        "IMAGEPULLBACKOFF",
        "IMAGE_PULL_BACK_OFF",
        "NOT_READY",
        "PENDING_PODS",
        "FAILED_PODS",
    }

    if cleaned_output in cpu_aliases:
        return "cpu"

    if cleaned_output in health_aliases:
        return "health"

    if cleaned_output in kubernetes_aliases:
        return "kubernetes"

    if cleaned_output == "UNHEALTHY":
        prometheus_terms = (
            "prometheus",
            "monitoring target",
            "monitoring targets",
            "scrape target",
            "scrape targets",
        )

        kubernetes_terms = (
            "kubernetes",
            "pod",
            "pods",
            "container",
            "containers",
            "workload",
            "workloads",
            "crashloopbackoff",
            "imagepullbackoff",
            "not ready",
            "pending",
            "failed",
        )

        if any(
            term in cleaned_question
            for term in prometheus_terms
        ):
            return "health"

        if any(
            term in cleaned_question
            for term in kubernetes_terms
        ):
            return "kubernetes"

        return "unsupported"

    if cleaned_output == "UNSUPPORTED":
        return "unsupported"

    return "unsupported"

def normalize_kubernetes_intent(
    model_output: str,
) -> Literal[
    "restarts",
    "unhealthy",
    "unsupported",
]:
    """
    Normalize Qwen output for the Kubernetes diagnostic branch.

    Approved restart-related aliases are mapped to the internal
    'restarts' route.

    Approved current-health aliases are mapped to the internal
    'unhealthy' route.

    Anything else fails closed to 'unsupported'.
    """

    cleaned_output = (
        model_output
        .strip()
        .upper()
        .replace("-", "_")
        .replace(" ", "_")
    )

    restart_aliases = {
        "RESTARTS",
        "POD_RESTARTS",
        "CONTAINER_RESTARTS",
        "HISTORICAL_RESTARTS",
        "HISTORICAL_POD_RESTARTS",
        "HISTORICAL_CONTAINER_RESTARTS",
        "RESTART_COUNT",
        "RESTART_COUNTS",
    }

    unhealthy_aliases = {
        "UNHEALTHY",
        "UNHEALTHY_PODS",
        "POD_HEALTH",
        "CURRENT_POD_HEALTH",
        "CRASHLOOPBACKOFF",
        "CRASH_LOOP_BACK_OFF",
        "IMAGEPULLBACKOFF",
        "IMAGE_PULL_BACK_OFF",
        "NOT_READY",
        "PENDING_PODS",
        "FAILED_PODS",
    }

    if cleaned_output in restart_aliases:
        return "restarts"

    if cleaned_output in unhealthy_aliases:
        return "unhealthy"

    if cleaned_output == "UNSUPPORTED":
        return "unsupported"

    return "unsupported"


def classify_primary_intent_node(
    state: SreGraphState,
) -> dict:
    """
    Use Qwen through vLLM to classify the top-level request.

    Qwen can select only CPU, HEALTH, KUBERNETES,
    or UNSUPPORTED.
    """

    question = state.get("question", "").strip()

    if not question:
        return {
            "route": "unsupported",
            "classification_raw": "",
            "classification_reason": (
                "The user question was empty."
            ),
        }

    messages = [
        (
            "system",
            (
                "You are the primary intent classifier for an "
                "SRE diagnostic workflow.\n\n"
                "Classify the user question into exactly one "
                "of these categories:\n\n"
                "CPU\n"
                "- Kubernetes node CPU utilization\n"
                "- Processor usage on cluster nodes\n"
                "- Compute utilization of nodes\n\n"
                "HEALTH\n"
                "- Prometheus scrape-target health\n"
                "- Whether Prometheus targets are UP or DOWN\n"
                "- Monitoring target reachability\n\n"
                "KUBERNETES\n"
                "- Pod restarts\n"
                "- CrashLoopBackOff\n"
                "- ImagePullBackOff\n"
                "- Pending or failed pods\n"
                "- Containers that are not ready\n"
                "- Currently unhealthy Kubernetes workloads\n\n"
                "UNSUPPORTED\n"
                "- Node memory utilization\n"
                "- GPU utilization or GPU temperature\n"
                "- Application logs\n"
                "- Questions outside the supported categories\n\n"
                "Return exactly one of these values:\n"
                "RESTARTS\n"
                "UNHEALTHY\n"
                "UNSUPPORTED\n\n"

                "Examples:\n"
                "Which pods have restarted? -> RESTARTS\n"
                "Show historical container restart counts. -> RESTARTS\n"
                "Which workloads restarted most often? -> RESTARTS\n"
                "Are any pods unhealthy now? -> UNHEALTHY\n"
                "Are any pods in CrashLoopBackOff? -> UNHEALTHY\n"
                "Are any containers not ready? -> UNHEALTHY\n\n"

                "Do not return HISTORICAL_CONTAINER_RESTARTS.\n"
                "Do not create a new category.\n"
                "Do not explain the answer.\n"
                "Return only RESTARTS, UNHEALTHY, or UNSUPPORTED."
            ),
        ),
        (
            "human",
            question,
        ),
    ]

    try:
        response = classifier_llm.invoke(messages)

        raw_output = str(
            response.content
        ).strip()

        route = normalize_primary_route(
            raw_output,
            question,
        )

        return {
            "route": route,
            "classification_raw": raw_output,
            "classification_reason": (
                "Primary route selected by Qwen "
                "through vLLM."
            ),
        }

    except Exception as exc:
        return {
            "route": "unsupported",
            "classification_raw": "",
            "classification_reason": (
                "Primary classification failed: "
                f"{type(exc).__name__}: {exc}"
            ),
            "error": (
                "Primary question classification failed."
            ),
        }


def route_primary_intent(
    state: SreGraphState,
) -> Literal[
    "collect_cpu_metrics",
    "collect_health_metrics",
    "classify_kubernetes_intent",
    "unsupported_question",
]:
    """
    Select the next graph node from the primary route.
    """

    route = state.get(
        "route",
        "unsupported",
    )

    if route == "cpu":
        return "collect_cpu_metrics"

    if route == "health":
        return "collect_health_metrics"

    if route == "kubernetes":
        return "classify_kubernetes_intent"

    return "unsupported_question"


def classify_kubernetes_intent_node(
    state: SreGraphState,
) -> dict:
    """
    Classify a Kubernetes question into restart-history or
    current unhealthy-state diagnostics.
    """

    question = state.get("question", "").strip()

    if not question:
        return {
            "kubernetes_intent": "unsupported",
            "kubernetes_classification_raw": "",
            "kubernetes_classification_reason": (
                "The Kubernetes question was empty."
            ),
        }

    messages = [
        (
            "system",
            (
                "You are a Kubernetes diagnostic intent "
                "classifier.\n\n"
                "Classify the question into exactly one "
                "of these categories:\n\n"
                "RESTARTS\n"
                "- Which pods have restarted\n"
                "- Restart counts\n"
                "- Historical container restarts\n"
                "- Workloads with the most restarts\n\n"
                "UNHEALTHY\n"
                "- Pods unhealthy right now\n"
                "- CrashLoopBackOff\n"
                "- ImagePullBackOff\n"
                "- Containers not ready\n"
                "- Pending, failed, or unknown pods\n"
                "- Currently failing workloads\n\n"
                "UNSUPPORTED\n"
                "- Kubernetes questions outside these two "
                "diagnostic capabilities\n\n"
                "Return only one word:\n"
                "RESTARTS\n"
                "UNHEALTHY\n"
                "UNSUPPORTED\n\n"
                "Do not explain the answer."
            ),
        ),
        (
            "human",
            question,
        ),
    ]

    try:
        response = classifier_llm.invoke(messages)

        raw_output = str(
            response.content
        ).strip()

        kubernetes_intent = (
            normalize_kubernetes_intent(
                raw_output
            )
        )

        return {
            "kubernetes_intent": kubernetes_intent,
            "kubernetes_classification_raw": (
                raw_output
            ),
            "kubernetes_classification_reason": (
                "Kubernetes sub-route selected by "
                "Qwen through vLLM."
            ),
        }

    except Exception as exc:
        return {
            "kubernetes_intent": "unsupported",
            "kubernetes_classification_raw": "",
            "kubernetes_classification_reason": (
                "Kubernetes classification failed: "
                f"{type(exc).__name__}: {exc}"
            ),
            "error": (
                "Kubernetes question classification failed."
            ),
        }


def route_kubernetes_intent(
    state: SreGraphState,
) -> Literal[
    "collect_restart_metrics",
    "collect_unhealthy_metrics",
    "unsupported_question",
]:
    """
    Route execution within the Kubernetes diagnostic branch.
    """

    kubernetes_intent = state.get(
        "kubernetes_intent",
        "unsupported",
    )

    if kubernetes_intent == "restarts":
        return "collect_restart_metrics"

    if kubernetes_intent == "unhealthy":
        return "collect_unhealthy_metrics"

    return "unsupported_question"


def collect_cpu_metrics_node(
    state: SreGraphState,
) -> dict:
    """
    Collect validated Kubernetes node CPU metrics.
    """

    try:
        return {
            "cpu_metrics": (
                get_current_node_cpu_percent()
            )
        }

    except Exception as exc:
        return {
            "error": (
                "CPU metric collection failed: "
                f"{type(exc).__name__}: {exc}"
            )
        }


def collect_health_metrics_node(
    state: SreGraphState,
) -> dict:
    """
    Collect current Prometheus target health.
    """

    try:
        return {
            "health_metrics": (
                get_prometheus_target_health()
            )
        }

    except Exception as exc:
        return {
            "error": (
                "Prometheus target-health collection "
