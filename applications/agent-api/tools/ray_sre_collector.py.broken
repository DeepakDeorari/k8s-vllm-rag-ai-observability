import os
import socket
import threading
import time
from typing import Any

import ray


RAY_ADDRESS = os.getenv(
    "RAY_ADDRESS",
    (
        "ray://"
        "ai-sre-ray-head-svc."
        "ray-cluster.svc.cluster.local:"
        "10001"
    ),
)

RAY_NAMESPACE = os.getenv(
    "RAY_NAMESPACE",
    "ai-sre-platform",
)

KNOWLEDGE_ACTOR_NAME = os.getenv(
    "RAY_KNOWLEDGE_ACTOR_NAME",
    "ai-sre-knowledge-v1",
)

DEFAULT_KNOWLEDGE_QUERY = (
    "How should Kubernetes workload health, "
    "pod restarts, Prometheus target failures, "
    "and node CPU problems be investigated?"
)

_ray_initialization_lock = threading.Lock()


def ensure_ray_connection() -> None:
    """
    Connect the caller to the existing KubeRay cluster.

    This function must never start an independent local Ray runtime.
    The configured address must therefore be explicit.
    """

    if ray.is_initialized():
        return

    with _ray_initialization_lock:
        if ray.is_initialized():
            return

        if not RAY_ADDRESS:
            raise RuntimeError(
                "RAY_ADDRESS must reference the existing "
                "KubeRay cluster."
            )

        ray.init(
            address=RAY_ADDRESS,
            namespace=RAY_NAMESPACE,
            ignore_reinit_error=True,
        )


def execution_metadata() -> dict[str, Any]:
    """
    Return the Ray and container execution location.
    """

    context = ray.get_runtime_context()

    hostname = socket.gethostname()

    return {
        "hostname": hostname,
        "pod_ip": socket.gethostbyname(
            hostname
        ),
        "pid": os.getpid(),
        "ray_node_id": context.get_node_id(),
        "assigned_resources": (
            context.get_assigned_resources()
        ),
    }


@ray.remote(
    num_cpus=0.25,
    max_retries=3,
)
def collect_prometheus_health() -> dict[str, Any]:
    """
    Collect Prometheus scrape-target health through a Ray Task.
    """

    from tools.prometheus_health import (
        get_prometheus_target_health,
    )

    start = time.perf_counter()

    evidence = (
        get_prometheus_target_health()
    )

    return {
        "source": "prometheus_health",
        "execution": execution_metadata(),
        "duration_seconds": round(
            time.perf_counter() - start,
            4,
        ),
        "evidence": evidence,
    }


